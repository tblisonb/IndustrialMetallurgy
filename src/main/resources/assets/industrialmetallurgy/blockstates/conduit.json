{
    "multipart": [
        { "apply": { "model": "industrialmetallurgy:block/conduit_core" } },
        { "when": { "north": "true" }, "apply": { "model": "industrialmetallurgy:block/conduit_arm_horizontal" } },
        { "when": { "east": "true" },  "apply": { "model": "industrialmetallurgy:block/conduit_arm_horizontal", "y": 90 } },
        { "when": { "south": "true" }, "apply": { "model": "industrialmetallurgy:block/conduit_arm_horizontal", "y": 180 } },
        { "when": { "west": "true" },  "apply": { "model": "industrialmetallurgy:block/conduit_arm_horizontal", "y": 270 } },
        { "when": { "up": "true" },    "apply": { "model": "industrialmetallurgy:block/conduit_arm_up" } },
        { "when": { "down": "true" },  "apply": { "model": "industrialmetallurgy:block/conduit_arm_down" } }
    ]
}
